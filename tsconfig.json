{
  "compilerOptions": {
    "incremental": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["jest", "chrome"],
    "rootDir": ".",
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@ui/*": ["./packages/ui/src/*"],
      "@cwc/core": ["./packages/core/src/index"],
      "@cwc/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
