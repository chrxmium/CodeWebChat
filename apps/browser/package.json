{
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs && node scripts/create-firefox-build.ts && node scripts/create-zip-archives.ts",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "bump": "node scripts/bump.js",
    "firefox:lint": "web-ext lint --source-dir dist-firefox",
    "firefox:run": "web-ext run --source-dir dist-firefox --target firefox-desktop",
    "firefox:sign": "web-ext sign --source-dir dist-firefox --channel unlisted --artifacts-dir dist-firefox-signed"
  },
  "devDependencies": {
    "@types/archiver": "6.0.4",
    "@types/node": "22.x",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/webextension-polyfill": "0.12.6",
    "archiver": "6.0.2",
    "baseline-browser-mapping": "2.11.35",
    "sass": "1.93.3",
    "vite": "8.3.6",
    "web-ext": "10.8.0",
    "webextension-polyfill": "0.12.0"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
